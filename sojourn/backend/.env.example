# Copy to .env and fill in what you need. Everything here is optional:
# with no .env at all, the app runs on SQLite and reminders go to the
# worker's log (console channel). See docs/reminders.md for the full story.

# --- database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./sojourn.db
# DATABASE_URL=mysql+pymysql://sojourn:sojourn@localhost:3306/sojourn   # after: docker compose up -d

# --- auth -------------------------------------------------------------------
# Anyone who knows this can sign in as anyone. Generate one: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

# --- maps, place search, time zones (optional; defaults are free & keyless) ---
# Full setup: docs/google-maps.md. Google search is only used when BOTH keys
# are set (Google's terms: its place data must be shown on a Google map).
# GOOGLE_MAPS_API_KEY=          # server key: enable Places API (New) + Time Zone API
# GOOGLE_MAPS_BROWSER_KEY=      # browser key: enable Maps JavaScript API, restrict by website
# GEOCODER=auto                 # auto | google | nominatim
# GOOGLE_PLACES_BASE=           # testing only: point at a stand-in server
# GOOGLE_MAPS_BASE=             # testing only

# --- reminders: where links in notifications point ---------------------------
APP_URL=http://localhost:5173

# --- reminders: email (any SMTP provider) ------------------------------------
# Local testing:  python -m aiosmtpd -n -l 127.0.0.1:8025 -c aiosmtpd.handlers.Mailbox ./maildir
# SMTP_HOST=127.0.0.1
# SMTP_PORT=8025
# SMTP_STARTTLS=false
# SMTP_FROM="One Trip <reminders@onetrip.local>"
#
# Gmail (needs an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM="One Trip <you@gmail.com>"
# SMTP_SSL=false               # true for port 465 providers

# --- reminders: browser notifications (Web Push) -----------------------------
# Generate once with:  python -m app.notify.vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- reminders: worker -------------------------------------------------------
# NOTIFY_CONSOLE=              # default: on only when neither email nor push is set up
# EMBEDDED_WORKER=false        # true = run the worker inside the API (handy in dev)
# WORKER_POLL_SECONDS=20
# REMINDER_STALE_HOURS=12      # skip reminders this far overdue instead of sending late
# DELIVERY_MAX_ATTEMPTS=5
# DELIVERY_LEASE_SECONDS=120
